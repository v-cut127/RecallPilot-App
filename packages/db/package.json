{
  "name": "@recallpilot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./import-commit": "./src/import-commit.ts",
    "./migrate": "./src/migrate.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset": "tsx src/reset.ts",
    "db:seed": "tsx src/seed.ts",
    "seed:data": "tsx src/generate-seed-csv.ts",
    "test:db": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@recallpilot/core": "*",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
