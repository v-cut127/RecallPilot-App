# ---------------------------------------------------------------------------
# RecallPilot App — environment template
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=replace-with-a-long-random-string

# Auth mode: "local" is a development-only adapter (no Docker/Supabase needed).
# Use "supabase" in deployed environments.
AUTH_PROVIDER=local

# Supabase (required when AUTH_PROVIDER=supabase and for hosted Postgres/Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Database — local portable Postgres by default (scripts/local-db.mjs)
DATABASE_URL=postgresql://recallpilot@127.0.0.1:55432/recallpilot
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Storage: "local" or "supabase"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
SUPABASE_STORAGE_BUCKET=imports

# Email: "console" (writes .outbox) or "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="RecallPilot <audit@recallpilot.com>"
EMAIL_OUTBOX_DIR=.outbox

# Retention and share links
AUDIT_LINK_TTL_DAYS=30
LEAD_RAW_RETENTION_HOURS=24
ORG_RAW_RETENTION_HOURS=168
LEAD_ROW_RETENTION_HOURS=24

# Worker
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=3101
PURGE_CRON=*/15 * * * *
